# URL canônica do ambiente, sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Opcional apenas em desenvolvimento/testes. Produção falha cedo sem uma site key válida;
# configure também a secret diretamente no Supabase Auth, nunca nesta aplicação.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Somente servidor. Usada apenas pelo agendador e pelo webhook dos lembretes pelo WhatsApp
# (ADR-0024); as telas nunca usam cliente privilegiado. Deixe vazio se não usar a automação.
SUPABASE_SECRET_KEY=

# Lembretes de cobrança pelo WhatsApp (ADR-0024). Somente servidor; mínimo de 16 caracteres.
# CRON_SECRET protege a rota diária chamada pelo Vercel Cron.
CRON_SECRET=
# App secret do app da Meta, usado para validar a assinatura do webhook.
WHATSAPP_APP_SECRET=
# Texto escolhido por você e repetido na configuração do webhook na Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
