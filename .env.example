# URL canônica do ambiente, sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Opcional apenas em desenvolvimento/testes. Produção falha cedo sem uma site key válida;
# configure também a secret diretamente no Supabase Auth, nunca nesta aplicação.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional e somente servidor. O MVP não usa cliente privilegiado; prefira deixar vazio.
SUPABASE_SECRET_KEY=
