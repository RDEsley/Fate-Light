# URL canônica do ambiente, sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Opcional apenas em desenvolvimento/testes. Produção falha cedo sem uma site key válida;
# configure também a secret diretamente no Supabase Auth, nunca nesta aplicação.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Somente servidor. Usada apenas pelo agendador e pelo webhook dos lembretes pelo WhatsApp
# (ADR-0024); as telas nunca usam cliente privilegiado. Deixe vazio se não usar a automação.
SUPABASE_SECRET_KEY=

# Lembretes de cobrança pelo WhatsApp (ADR-0024). Somente servidor; mínimo de 16 caracteres.
# CRON_SECRET protege a rota diária chamada pelo Vercel Cron.
CRON_SECRET=
# App secret do app da Meta, usado para validar a assinatura do webhook.
WHATSAPP_APP_SECRET=
# Texto escolhido por você e repetido na configuração do webhook na Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Assistente com IA (ADR-0026). Somente servidor; sem chave, o painel avisa que está indisponível.
# Chave do Google AI Studio, no plano gratuito.
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional: fallback quando a cota da Gemini acaba.
GROQ_API_KEY=
# Opcionais: substituem os modelos padrão de src/features/assistant/model.ts.
AGENT_MODEL=
AGENT_FALLBACK_MODEL=
# Assina as aprovações de escrita. Mínimo de 32 caracteres aleatórios.
AGENT_APPROVAL_SECRET=
# Sal do hash de IP do limite de visitantes. Mínimo de 16 caracteres aleatórios.
AGENT_IP_HASH_SALT=
# Teto diário de mensagens somando todos os visitantes. Padrão: 30.
AGENT_GUEST_DAILY_CAP=
# Só ligue (true) depois de revisar a política de privacidade: envia dados reais ao provedor.
AGENT_REAL_DATA_ENABLED=false
